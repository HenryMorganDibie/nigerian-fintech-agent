# ┌──────────────────────────────────────────────────────────────────┐
# │  NaijaFinAI — Environment Configuration                          │
# │                                                                  │
# │  STEP 1: cp .env.example .env                                   │
# │  STEP 2: Set ADMIN_TOKEN and SECRET_KEY (long random strings)   │
# │  STEP 3: docker compose up   (Postgres + Redis + API + UI)      │
# └──────────────────────────────────────────────────────────────────┘

APP_ENV=development

# ── Platform ──────────────────────────────────────────────────────
# Keyed hashing of customer identifiers. MUST be random and secret in production.
SECRET_KEY=
# Enables /v1/admin (tenant + API key management). Empty = admin API disabled.
ADMIN_TOKEN=
# true: also mount the open /api/* demo sandbox. Set false for customer deployments.
DEMO_MODE=true
# Mode for newly onboarded tenants: shadow (score, never enforce) or live.
DEFAULT_TENANT_MODE=shadow

# ── State ─────────────────────────────────────────────────────────
# SQLite for local dev; Postgres in production. postgres:// URLs are accepted.
DATABASE_URL=sqlite:///./naijafinai.db
# Behavioural feature store. Empty = in-memory (lost on restart).
# REDIS_URL=redis://localhost:6379/0

# ── LLM rotation (analyst narratives and chat only; never on the decision path) ──
# Order: Ollama pool → Groq models → OpenAI → Anthropic. Any provider without a key is skipped.
# Rate limits (429/529) cool a model for 60s; errors and timeouts back off 2s → 5min.
GROQ_API_KEY=
# Strongest first. Empty = openai/gpt-oss-120b, openai/gpt-oss-20b, then GROQ_MODEL, GROQ_FALLBACK_MODEL.
GROQ_MODELS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=groq

# Local Ollama pool: discovers pulled models, benchmarks them, uses the fastest healthy one.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# first: Ollama before remote  | last: remote first, Ollama as final fallback (default)
# off: never                   | only: on-machine models only, no data leaves the deployment
LLM_LOCAL_POOL=last
OLLAMA_MIN_QUALITY=0.5
OLLAMA_TIMEOUT_S=30
LLM_TIMEOUT_S=20

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
